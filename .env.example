# Copy this file to .env and fill in your key:  cp .env.example .env
# .env is gitignored; this template is safe to commit.

# Your Groq API key. Unset/blank => offline stub mode (no network, no key).
GROQ_API_KEY=

# Optional overrides (defaults shown):
# POLYGLOT_GROQ_MODEL=llama-3.3-70b-versatile
# POLYGLOT_TARGET_LANGUAGE=python
# POLYGLOT_AGENT_COUNT=8
# POLYGLOT_MAX_LINES_PER_UNIT=200
# POLYGLOT_API_HOST=127.0.0.1
# POLYGLOT_API_PORT=8000
# POLYGLOT_DB_PATH=polyglot_swarm.db
